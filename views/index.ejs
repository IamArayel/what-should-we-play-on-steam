<!DOCTYPE html>
<html lang="en">
<% locals.styles = [
    '/dist/fontawesome/css/fontawesome.min.css',
    '/dist/fontawesome/css/brands.min.css',
    '/dist/fontawesome/css/solid.min.css',
    '/styles/index.css'
]; %>
<% include _partials/head.ejs %>
<body>
<% include _partials/header.ejs %>

<main id="index"
      class="content">
    <h1 class="hero">Find a game the whole squad owns.</h1>

    <section class="card result"
             aria-live="polite"
             v-if="selectedGame">
        <div class="result-image">
            <img alt=""
                 width="460"
                 height="215"
                 :class="{ loading: loading }"
                 :src="getLogoUri(selectedGame)"/>
        </div>
        <div class="result-info">
            <span class="result-eyebrow">
                <i class="fas fa-check"
                   aria-hidden="true"></i>
                Everyone owns it
            </span>
            <h2>{{selectedGame.name}}</h2>
            <div class="result-actions">
                <a class="btn btn-outline"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Visit the store page"
                   :href="'//store.steampowered.com/app/' + selectedGame.id">
                    <i class="fas fa-store"
                       aria-hidden="true"></i>
                    Store
                </a>
                <a class="btn btn-success"
                   title="Launch game"
                   :href="'steam://run/' + selectedGame.id">
                    <i class="fas fa-play"
                       aria-hidden="true"></i>
                    Launch
                </a>
                <span class="result-remaining">{{remaining}} left to roll</span>
            </div>
        </div>
    </section>

    <section class="empty-state"
             v-else>
        <div class="empty-state-icon">
            <i class="fas fa-dice"
               aria-hidden="true"></i>
        </div>
        <div>
            <span class="empty-state-title">No game picked yet</span>
            <span class="empty-state-hint"
                  v-if="getResolvedCount() < 2">Add at least two players, then roll the dice.</span>
            <span class="empty-state-hint"
                  v-else>{{matchingGames}} games in common. Hit the dice to pick one.</span>
        </div>
    </section>

    <div class="columns">
        <div class="column-main">
            <section class="card players"
                     aria-labelledby="players-title">
                <div class="card-header">
                    <h3 id="players-title">Players</h3>
                    <span class="pill">{{getResolvedCount()}}</span>
                    <span class="card-note">
                        <i class="fas fa-lock-open"
                           aria-hidden="true"></i>
                        Profiles and game lists must be public
                    </span>
                </div>

                <ul class="player-list">
                    <template v-for="(user, index) in users">
                        <li class="player"
                            v-if="isResolved(user)">
                            <img class="avatar"
                                 alt=""
                                 v-if="details[user].icon"
                                 :src="details[user].icon"
                                 :title="games[user] && games[user].length + ' games'"/>
                            <span class="avatar avatar-placeholder"
                                  v-else>
                                <i class="fab fa-steam"
                                   aria-hidden="true"></i>
                            </span>
                            <div class="player-info">
                                <span class="player-name">{{details[user].name}}</span>
                                <span class="player-games">{{games[user] ? games[user].length : 0}} games</span>
                            </div>
                            <span class="badge"
                                  v-if="privateFriendLists.indexOf(details[user].id) !== -1"
                                  title="Their friends won't be suggested">
                                <i class="fas fa-user-lock"
                                   aria-hidden="true"></i>
                                Friends private
                            </span>
                            <span class="badge"
                                  v-if="failedFriendLists.indexOf(details[user].id) !== -1"
                                  title="Their friends won't be suggested">
                                <i class="fas fa-user-lock"
                                   aria-hidden="true"></i>
                                Friends unavailable
                            </span>
                            <button class="icon-btn icon-btn-danger"
                                    type="button"
                                    title="Remove player"
                                    :aria-label="'Remove ' + details[user].name"
                                    @click="removeFromUsers(index)"
                                    :disabled="loading">
                                <i class="fas fa-user-slash"
                                   aria-hidden="true"></i>
                            </button>
                        </li>
                    </template>
                </ul>

                <template v-for="(user, index) in users">
                    <div class="player-field"
                         v-if="!isResolved(user)">
                        <div class="field"
                             :class="{ error: details[user] && details[user].error }">
                            <i v-if="details[user] && details[user].error"
                               class="fas fa-exclamation-triangle field-icon"
                               :title="getErrorMessage(details[user].error)"></i>
                            <i v-else
                               class="fab fa-steam field-icon"
                               aria-hidden="true"></i>
                            <input v-model.trim="users[index]"
                                   @input="onUserInput(index)"
                                   @keydown="onUserKeydown($event, index)"
                                   @blur="onUserBlur()"
                                   type="text"
                                   placeholder="Steam ID or friend name"
                                   role="combobox"
                                   aria-autocomplete="list"
                                   :aria-label="'Player ' + (index + 1)"
                                   :aria-expanded="suggestionIndex === index && suggestions.length > 0 ? 'true' : 'false'"
                                   :aria-controls="'suggestions-' + index"
                                   :aria-activedescendant="suggestionIndex === index && highlightedSuggestion >= 0 ? 'suggestion-' + index + '-' + highlightedSuggestion : null"/>
                            <button class="icon-btn icon-btn-danger"
                                    type="button"
                                    title="Remove player"
                                    :aria-label="'Remove player ' + (index + 1)"
                                    v-if="user !== ''"
                                    @click="removeFromUsers(index)"
                                    :disabled="loading">
                                <i class="fas fa-user-slash"
                                   aria-hidden="true"></i>
                            </button>
                            <button class="btn btn-secondary"
                                    type="button"
                                    @click="getDetails()"
                                    :disabled="loading">
                                <i class="fas fa-plus"
                                   aria-hidden="true"></i>
                                Add
                            </button>
                        </div>
                        <ul class="suggestions"
                            role="listbox"
                            v-if="suggestionIndex === index && suggestions.length > 0"
                            :id="'suggestions-' + index"
                            :aria-label="'Suggestions for player ' + (index + 1)">
                            <li class="suggestions-label"
                                role="presentation">Friends of your players</li>
                            <li class="suggestion"
                                role="option"
                                v-for="(friend, suggestion) in suggestions"
                                :key="friend.id"
                                :id="'suggestion-' + index + '-' + suggestion"
                                :class="{ highlighted: suggestion === highlightedSuggestion }"
                                :aria-selected="suggestion === highlightedSuggestion ? 'true' : 'false'"
                                @mousedown.prevent="selectSuggestion(index, friend)">
                                <img class="avatar"
                                     alt=""
                                     :src="friend.icon"/>
                                <span class="name">{{friend.name}}</span>
                            </li>
                        </ul>
                    </div>
                </template>
            </section>

            <p class="intro">
                Add each player by Steam custom URL or 17-digit ID.
                Once one player is found, type a friend's name to get suggestions. Then roll.
            </p>

            <section class="help">
                <span class="eyebrow eyebrow-muted">Not finding someone?</span>
                <div class="help-row">
                    <i class="fas fa-eye help-icon-warn"
                       aria-hidden="true"></i>
                    <span>Steam profile <b>and</b> game details must be set to <b>Public</b> in Steam privacy settings.</span>
                </div>
                <div class="help-row">
                    <i class="fas fa-hashtag help-icon-accent"
                       aria-hidden="true"></i>
                    <span>Use the part after <code>steamcommunity.com/id/</code> or the 17-digit ID.</span>
                </div>
            </section>
        </div>

        <section class="card venn"
                 aria-labelledby="venn-title">
            <div class="card-header card-header-stacked">
                <h3 id="venn-title">Your libraries</h3>
                <span class="card-note">One shape per player. The dice picks from the middle, where they all overlap. Hover a shape to see whose it is.</span>
            </div>

            <div class="venn-body">
                <%# Always rendered, so its reserved height keeps the diagram still when a hover fills it %>
                <p class="venn-caption">
                    <template v-if="getHoveredPlayer()">
                        <img class="avatar"
                             alt=""
                             v-if="details[getHoveredPlayer()].icon"
                             :src="details[getHoveredPlayer()].icon"/>
                        <span class="venn-caption-name">{{details[getHoveredPlayer()].name}}</span>
                        <span class="venn-caption-games">{{games[getHoveredPlayer()] ? games[getHoveredPlayer()].length : 0}} games</span>
                    </template>
                    <template v-else-if="getResolvedCount() === 1">
                        Add another player to see what you share.
                    </template>
                    <template v-else-if="getResolvedCount() === 0">
                        Add players to see how your libraries overlap.
                    </template>
                </p>

                <svg class="venn-diagram"
                     viewBox="-230 -230 460 460"
                     role="group"
                     aria-label="Players' libraries"
                     v-if="getResolvedCount() > 0"
                     :class="{ 'has-hovered': getHoveredPlayer() }">
                    <defs>
                        <%# Each clip is clipped by the previous one, so the last clip is the area shared by everyone %>
                        <clipPath v-for="(player, index) in getVennPlayers()"
                                  :id="'venn-clip-' + index">
                            <ellipse :rx="player.rx"
                                     :ry="player.ry"
                                     :transform="player.transform"
                                     :clip-path="index > 0 ? 'url(#venn-clip-' + (index - 1) + ')' : null"/>
                        </clipPath>
                    </defs>
                    <ellipse class="venn-player"
                             v-for="player in getVennPlayers()"
                             tabindex="0"
                             role="img"
                             :aria-label="details[player.user].name + ', ' + (games[player.user] ? games[player.user].length : 0) + ' games'"
                             :class="{ hovered: getHoveredPlayer() === player.user }"
                             :style="{ fill: player.color, stroke: player.color }"
                             :rx="player.rx"
                             :ry="player.ry"
                             :transform="player.transform"
                             @mouseenter="hoveredPlayer = player.user"
                             @mouseleave="hoveredPlayer = null"
                             @focus="hoveredPlayer = player.user"
                             @blur="hoveredPlayer = null"/>
                    <rect class="venn-common"
                          x="-230"
                          y="-230"
                          width="460"
                          height="460"
                          :clip-path="'url(#venn-clip-' + (getResolvedCount() - 1) + ')'"/>
                    <text class="venn-count"
                          x="0"
                          y="0"
                          text-anchor="middle"
                          dominant-baseline="central"
                          v-if="getResolvedCount() > 1">{{matchingGames}}</text>
                </svg>
            </div>
        </section>

        <aside class="column-side">
            <section class="card roll-card">
                <div class="common-count">
                    <span class="common-count-value">{{matchingGames}}</span>
                    <span class="common-count-label">games in common</span>
                </div>
                <button class="btn-roll"
                        type="button"
                        title="What should we play?"
                        @click="whatShouldWePlay()"
                        :disabled="loading || getResolvedCount() < 2">
                    <i v-if="!loading"
                       class="fas fa-dice"
                       aria-hidden="true"></i>
                    <i v-if="loading"
                       class="fas fa-spinner fa-spin"
                       aria-hidden="true"></i>
                    What should we play?
                </button>
            </section>

            <section class="card groups"
                     aria-labelledby="groups-title">
                <div class="card-header card-header-stacked">
                    <h3 id="groups-title">Groups</h3>
                    <span class="card-note">Save your usual squads. Stored in this browser.</span>
                </div>

                <div class="alert error"
                     role="alert"
                     v-if="groupError">
                    {{groupError}}
                </div>

                <form class="group-save"
                      @submit.prevent="saveGroup()">
                    <input class="input"
                           v-model.trim="groupName"
                           type="text"
                           maxlength="50"
                           placeholder="Group name"
                           aria-label="Group name"/>
                    <button class="btn btn-success"
                            type="submit"
                            :disabled="!canSaveGroup">
                        <i class="fas fa-save"
                           aria-hidden="true"></i>
                        Save
                    </button>
                </form>

                <ul class="group-list"
                    v-if="groups.length > 0">
                    <li class="group"
                        v-for="group in groups"
                        :key="group.name"
                        :class="{ active: isActiveGroup(group) }">
                        <div class="group-info">
                            <span class="group-name">{{group.name}}</span>
                            <div class="group-members">
                                <span class="faces">
                                    <template v-for="member in group.members.slice(0, 5)">
                                        <img class="face"
                                             alt=""
                                             v-if="details[member] && details[member].icon"
                                             :src="details[member].icon"/>
                                        <span class="face face-placeholder"
                                              v-else>
                                            <i class="fab fa-steam"
                                               aria-hidden="true"></i>
                                        </span>
                                    </template>
                                </span>
                                <span class="group-count">{{group.members.length}} players</span>
                            </div>
                        </div>
                        <button class="btn btn-outline btn-small"
                                type="button"
                                @click="loadGroup(group.name)"
                                :disabled="loading">
                            {{isActiveGroup(group) ? 'Loaded' : 'Load'}}
                        </button>
                        <button class="icon-btn icon-btn-danger"
                                type="button"
                                :aria-label="'Delete group ' + group.name"
                                :title="'Delete group ' + group.name"
                                @click="deleteGroup(group.name)">
                            <i class="fas fa-trash"
                               aria-hidden="true"></i>
                        </button>
                    </li>
                </ul>
                <p class="empty"
                   v-else>
                    No saved groups yet. Add some players, name the group and save it.
                </p>
            </section>
        </aside>
    </div>
</main>

<% include _partials/footer.ejs %>

<% locals.scripts = [
    '/dist/vue/vue.min.js',
    '/dist/q/q.js',
    '/dist/axios/axios.min.js',
    '/scripts/index.js'
]; %>
<% include _partials/scripts.ejs %>
</body>
</html>
