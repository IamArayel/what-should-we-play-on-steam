<head>

	<% include meta.ejs %>

	<%
	let titleString = 'What Should We Play On Steam';
	if (Array.isArray(locals.route)) {
		locals.route.forEach((value) => {
			titleString = value.title + ' - ' + titleString;
		});
	}
	%>
	<title><%= titleString %></title>

	<script src="/scripts/theme.js"></script>

	<link rel="preconnect"
		  href="https://fonts.googleapis.com"/>
	<link rel="preconnect"
		  href="https://fonts.gstatic.com"
		  crossorigin/>
	<link rel="stylesheet"
		  href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"/>

	<% include styles.ejs %>

</head>
